{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=zinema_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "SeedOnStartup": false
  },
  "Jwt": {
    "Issuer": "Zinema.Local",
    "Audience": "Zinema.Local",
    "SigningKey": "development-only-signing-key-change-me-minimum-32-characters",
    "ExpirationMinutes": 60
  },
  "Auth": {
    "SeedDevelopmentAdmin": false,
    "DevelopmentAdminEmail": "",
    "DevelopmentAdminPassword": "",
    "DevelopmentAdminDisplayName": "Development Admin"
  },
  "ObjectStorage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "zinema-media",
    "UseSsl": false,
    "EnsureBucketExists": true,
    "PublicBaseUrl": "http://localhost:9000/zinema-media"
  },
  "MediaUpload": {
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
