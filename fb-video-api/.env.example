# Template only; process environment required. No dotenv auto-loading.
APP_ENV=development
EXTRACTOR_MODE=disabled
PORT=3333
# local mode returns this fixed fake URL without inspecting the request URL.
FAKE_MEDIA_URL=http://127.0.0.1:9082/demo.mp4
EXTRACTOR_API_KEY=REPLACE_LOCAL_EXTRACTOR_KEY
# Live extraction is quarantined in every environment pending security repair.
