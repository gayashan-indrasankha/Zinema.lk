# Template only. PHP reads process environment, NOT .env files automatically.
# Use database/schema.sql only with a new isolated database; never import Database.sql.
APP_ENV=development
BASE_URL=http://127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zinema_recovery_development
DB_USER=zinema_recovery_dev
DB_PASS=REPLACE_LOCAL_PASSWORD
SESSION_SAVE_PATH=D:/Movie_Website/.runtime/php-sessions
ALLOW_LIVE_INTEGRATIONS=false
MAIL_MODE=disabled
OAUTH_MODE=disabled
WHATSAPP_MODE=disabled
MEDIA_MODE=disabled
EXTRACTOR_MODE=disabled
PAYMENT_MODE=disabled
# Optional local substitutes; activate a MODE only after provisioning its fake.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=REPLACE_FAKE_MAIL_USER
MAIL_PASSWORD=REPLACE_FAKE_MAIL_PASSWORD
MAIL_FROM_EMAIL=demo@example.invalid
MAIL_FROM_NAME=Recovery Demo
GOOGLE_CLIENT_ID=REPLACE_FAKE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_FAKE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/google-callback.php
OAUTH_AUTHORIZE_URL=http://127.0.0.1:9081/authorize
OAUTH_TOKEN_URL=http://127.0.0.1:9081/token
OAUTH_USERINFO_URL=http://127.0.0.1:9081/userinfo
WHATSAPP_API_KEY=REPLACE_FAKE_SHARED_KEY
STREAM_SIGNING_SECRET=REPLACE_FAKE_SIGNING_KEY
STREAM_BASE_URL=http://127.0.0.1:9082
FB_VIDEO_API_URL=http://127.0.0.1:3333
PAYMENT_APP_ID=REPLACE_FAKE_PAYMENT_ID
PAYMENT_APP_SECRET=REPLACE_FAKE_PAYMENT_SECRET
PAYMENT_API_URL=http://127.0.0.1:9083/subscribe
# Payment routes, download and maintenance jobs remain unconditionally disabled.

# Optional support contact; leave empty for local demonstrations. Live gates still apply.
SUPPORT_WHATSAPP_NUMBER=
