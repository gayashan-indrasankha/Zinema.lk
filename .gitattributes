* text=auto
*.php text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.png binary
*.ico binary

# ZL-13 Linux entrypoint/configuration files need LF on Windows checkouts.
*.sh text eol=lf
*.conf text eol=lf
*.ini text eol=lf
Dockerfile text eol=lf
# SQL migration checksums are calculated over these exact LF bytes.
/database/migrations/*.sql text eol=lf
